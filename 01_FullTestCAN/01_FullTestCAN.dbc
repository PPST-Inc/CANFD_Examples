CM_ SG_ 7 PM_A_Peak_Current "This signal periodically returns the measured peak current for phase A.
SCPI equivalent:
  MEASure:CURRent:PEAK1?";
CM_ SG_ 8 PM_A_Power_Factor_Angle "This signal periodically returns the measured power factor angle for phase A.";
CM_ SG_ 8 PM_A_Power_Factor "This signal periodically returns the measured power factor for phase A.
SCPI equivalent:
  MEASure:PF1?";
CM_ SG_ 9 PM_A_Voltage_ACDC "This signal periodically returns the measured RMS voltage for phase A.
SCPI equivalent:
  MEASure:VOLTage:ACDC1?";
CM_ SG_ 9 PM_A_Voltage_AC "This signal periodically returns the measured RMS voltage for phase A.
SCPI equivalent:
  MEASure:VOLTage:AC1?";
CM_ SG_ 2 PM_A_Crest_Factor "This signal periodically returns the measured current crest factor for phase A.
SCPI equivalent:
  MEASure:CURRent:CREST1?";
CM_ SG_ 2 PM_A_Active_Power "This signal periodically returns the measured true power for phase A in kW.
SCPI equivalent:
  MEASure:POWer1?";
CM_ SG_ 1 PM_ALL_VoltageLL_DC "This signal periodically returns the measured DC Line-to-Line voltage.
SCPI equivalent:
  MEASure:VLL:DC?";
CM_ SG_ 1 PM_ALL_VoltageLL_ACDC "This signal periodically returns the measured RMS Line-to-Line voltage.
SCPI equivalent:
  MEASure:VLL:ACDC?";
CM_ SG_ 1 PM_ALL_VoltageLL_AC "This signal periodically returns the measured RMS Line-to-Line voltage.
SCPI equivalent:
  MEASure:VLL:AC?";
CM_ SG_ 1 PM_ALL_Voltage_THD "This signal periodically returns the measured THD voltage.
SCPI equivalent:
  MEASure:VOLTage:ACDC1:THD?";
CM_ SG_ 1 PM_ALL_Voltage_DC "This signal periodically returns the measured DC voltage.
SCPI equivalent:
  MEASure:VOLTage:DC?";
CM_ SG_ 1 PM_ALL_Voltage_ACDC "This signal periodically returns the measured RMS voltage.
SCPI equivalent:
  MEASure:VOLTage:ACDC?";
CM_ SG_ 1 PM_ALL_Voltage_AC "This signal periodically returns the measured RMS voltage.
SCPI equivalent:
  MEASure:VOLTage:AC?";
CM_ SG_ 1 PM_ALL_Power_Factor_Angle "This signal periodically returns the measured power factor angle.";
CM_ SG_ 1 PM_ALL_Power_Factor "This signal periodically returns the measured power factor.
SCPI equivalent:
  MEASure:PF?";
CM_ SG_ 1 PM_ALL_Peak_Current_Recoded "This signal periodically returns the recorded peak current.
SCPI equivalent:
  MEASure:CURRent:PEAK1:HOLD?";
CM_ SG_ 1 PM_ALL_Peak_Current "This signal periodically returns the measured peak current.
SCPI equivalent:
  MEASure:CURRent:PEAK?";
CM_ SG_ 1 PM_ALL_KWH_Elapsed_Time "This signal periodically returns the accumulated energy measurement time in seconds.
SCPI equivalent:
  MEASure:KWHour:ETIMe?";
CM_ SG_ 1 PM_ALL_Kilowatt_Hour "This signal periodically returns the accumulated energy measurement in kWh.
SCPI equivalent:
  MEASure:KWHour?";
CM_ SG_ 1 PM_ALL_Frequency "This signal periodically returns the measured frequency.
SCPI equivalent:
  MEASure:FREQuency?";
CM_ SG_ 1 PM_ALL_Distortion_Factor "This signal periodically returns the measured distortion factor.
Is calculated from the measured of power factor and displacement factor:
  Power_Factor/Displacement_Factor";
CM_ SG_ 1 PM_ALL_Displacement_Factor "This signal periodically returns the measured displacement factor.
Is calculated from the measured of Power Factor:
  cos(Power_Factor * PI/180)";
CM_ SG_ 1 PM_ALL_Current_THD "This signal periodically returns the measured THD current.
SCPI equivalent:
  MEASure:CURRent:ACDC1:THD?";
CM_ SG_ 1 PM_ALL_Current_DC "This signal periodically returns the measured DC current.
SCPI equivalent:
  MEASure:CURRent:DC?";
CM_ SG_ 1 PM_ALL_Current_ACDC "This signal periodically returns the measured RMS current.
SCPI equivalent:
  MEASure:CURRent:ACDC?";
CM_ SG_ 1 PM_ALL_Crest_Factor "This signal periodically returns the measured current crest factor.
SCPI equivalent:
  MEASure:CURRent:CREST?";
CM_ SG_ 1 PM_ALL_Active_Power "This signal periodically returns the measured true power in kW.
SCPI equivalent:
  MEASure:POWer3?";
